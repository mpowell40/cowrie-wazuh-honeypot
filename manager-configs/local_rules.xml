<!-- Example -->
<group name="local,syslog,sshd,">

  <!--
  Dec 10 01:02:02 host sshd[1234]: Failed none for root from 1.1.1.1 port 1066 ssh2
  -->
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

  <!-- Cowrie Honeypot Rules -->
  <!-- Base Cowrie Group -->
  <rule id="100100" level="0">
    <decoded_as>json</decoded_as>
    <field name="eventid">^cowrie\.</field>
    <description>Cowrie honeypot event grouped</description>
  </rule>

  <!-- Failed Login Attempt -->
  <rule id="100101" level="5">
    <if_sid>100100</if_sid>
    <field name="eventid">cowrie.login.failed</field>
    <description>Cowrie: SSH brute-force or failed login attempt</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failed,</group>
  </rule>

  <!-- Successful Login Attempt -->
  <rule id="100102" level="10">
    <if_sid>100100</if_sid>
    <field name="eventid">cowrie.login.success</field>
    <description>Cowrie: Attacker logged into honeypot interactive shell</description>
    <mitre>
      <id>T1078</id>
    </mitre>
    <group>authentication_success,</group>
  </rule>

  <!-- Attacker Executed Command -->
  <rule id="100103" level="8">
    <if_sid>100100</if_sid>
    <field name="eventid">cowrie.command.input</field>
    <description>Cowrie: Attacker command executed in honeypot</description>
    <mitre>
      <id>T1059</id>
    </mitre>
    <group>command_execution,</group>
  </rule>

  <!-- Attacker Opened Connection / Scanner Probe -->
  <rule id="100104" level="3">
    <if_sid>100100</if_sid>
    <field name="eventid">cowrie.session.connect</field>
    <description>Cowrie: Inbound connection / scanner probe detected</description>
    <mitre>
      <id>T1046</id>
    </mitre>
    <group>reconnaissance,</group>
  </rule>

  <!-- Attacker SSH Version String / Fingerprint Grab -->
  <rule id="100105" level="3">
    <if_sid>100100</if_sid>
    <field name="eventid">cowrie.client.version</field>
    <description>Cowrie: SSH client banner/scanner fingerprint received</description>
    <group>reconnaissance,</group>
  </rule>

  <!-- Attacker Disconnected / Connection Closed -->
  <rule id="100106" level="3">
    <if_sid>100100</if_sid>
    <field name="eventid">cowrie.session.closed</field>
    <description>Cowrie: Attacker disconnected from session</description>
    <group>reconnaissance,</group>
  </rule>

</group>
